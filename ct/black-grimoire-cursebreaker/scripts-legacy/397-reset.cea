{$lua}
[ENABLE]

local ppc = mc.PostProcessingChanger:instanceFrom(mc.CBCameraController.static.instance, mc.CBCameraController.offset.postprocessing)

for _,v in pairs({
  'aoIntensity',
  'aoRadius',
  'saturation',
  'focusDistance'
})
do ppc[v] = ppc['start_'..v] end

alce.cheat_table.disableAfterSuccess({})
[DISABLE]
