{ Game   : Cursebreaker.exe
  Version: build 20372594 (from roughly 2025-10)

  XP multiplier
}
{$STRICT}

define(address,PlayerLevels:AddXp+253)
define(bytes,F3 41 0F 10 46 14 F3 0F 5A C0 F3 0F 10 4D D8 F3 0F 5A C9 F2 0F 58 C1 F2 0F 5A E8 F3 41 0F 11 6E 14)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,PlayerLevels:AddXp+253)

label(code)
label(return)
label(cfg_Tdouble_multiplier_xp)
registersymbol(cfg_Tdouble_multiplier_xp)

newmem:

code:
  movss xmm0,[r14+14] // current xp (T: UnitSkills+Skill)
  cvtss2sd xmm0,xmm0
  movss xmm1,[rbp-28] // exp being gained (unknown?)
  cvtss2sd xmm1,xmm1
  //--< added multiplier behavior
  movsd xmm15,[cfg_Tdouble_multiplier_xp]
  mulpd xmm1,xmm15
  xorps xmm15,xmm15
  //-->
  addsd xmm0,xmm1     // current + new
  cvtsd2ss xmm5,xmm0
  movss [r14+14],xmm5 // write new
  jmp return
cfg_Tdouble_multiplier_xp:
  dq (double)2
address:
  jmp code
  nop 1C
return:

[DISABLE]
address:
  db bytes

dealloc(newmem)
unregistersymbol(cfg_Tdouble_multiplier_xp)

