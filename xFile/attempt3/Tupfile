# testbed
: foreach $(NAME_TESTBED)/src/*.cpp |> ^o^ g++ $(CXXFLAGS) $(LFLAGS) -c %f -o %o |> obj/$(NAME_TESTBED)/%B.o <objs>
: <objs> | <common_objs> |> g++ $(CXXFLAGS) $(LFLAGS) %<objs> %<common_objs> -o %o $(LIBS) |> bin/$(NAME_TESTBED)/$(NAME_TESTBED).exe
