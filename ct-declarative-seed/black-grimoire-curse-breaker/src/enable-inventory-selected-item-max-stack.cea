{$lua}
if syntaxcheck then return end

[ENABLE]
assert(PlayerInventory)
local slot = mc['UI_Inventory+ItemSlot']:Instance(PlayerInventory.usingItemSlot)
local id = slot.itemId
assert(GameItemID2Name[id], 'Got an invalid ID: ' .. tostring(id))
local maxStack = mc['ItemHandler+Item']:Instance(GameItemHandler:GetItem(id)).maxStack
assert(alce.isPositiveInteger(maxStack), 'Got an invalid number for max stack: ' .. tostring(maxStack))
slot.itemAmount = maxStack
alce.cheattable.disableAfterSuccess()
[DISABLE]
